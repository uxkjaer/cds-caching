<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout">

    <l:VerticalLayout width="100%">
        <MessageStrip
            text="{i18n>warningEntries}"
            type="Warning"
            showIcon="true"
            class="sapUiSmallMarginBottom" />
        <Button
            text="{i18n>btnLoadEntries}"
            icon="sap-icon://download"
            type="Emphasized"
            press=".extension.cds.plugin.caching.dashboardfe.ext.ObjectPageExtension.onLoadCacheEntries"
            class="sapUiSmallMarginBottom" />

        <!-- VBox binding context set programmatically from function result; table binds to {value} -->
        <VBox id="entriesResultContainer">
            <Table id="entriesTable" items="{value}" noDataText="No cache entries found">
                <columns>
                    <Column><Text text="{i18n>colKey}" /></Column>
                    <Column><Text text="{i18n>colValue}" /></Column>
                    <Column><Text text="{i18n>colTags}" /></Column>
                    <Column><Text text="{i18n>colTimestamp}" /></Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{entryKey}" />
                            <Text text="{value}" />
                            <Text text="{tags}" />
                            <Text text="{timestamp}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </VBox>
    </l:VerticalLayout>

</core:FragmentDefinition>

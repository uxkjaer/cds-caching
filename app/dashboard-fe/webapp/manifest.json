{
    "_version": "1.76.0",
    "sap.app": {
        "id": "cds.plugin.caching.dashboardfe",
        "type": "application",
        "i18n": "i18n/i18n.properties",
        "applicationVersion": { "version": "1.0.0" },
        "title": "{{appTitle}}",
        "description": "{{appDescription}}",
        "dataSources": {
            "caching": {
                "uri": "/odata/v4/caching-api/",
                "type": "OData",
                "settings": {
                    "annotations": [],
                    "odataVersion": "4.0"
                }
            }
        }
    },
    "sap.ui": {
        "technology": "UI5",
        "deviceTypes": { "desktop": true, "tablet": true, "phone": true }
    },
    "sap.ui5": {
        "flexEnabled": true,
        "dependencies": {
            "minUI5Version": "1.148.10",
            "libs": {
                "sap.fe.templates": {},
                "sap.fe.macros": {},
                "sap.m": {},
                "sap.ui.core": {},
                "sap.suite.ui.microchart": {}
            }
        },
        "models": {
            "": {
                "dataSource": "caching",
                "preload": true,
                "settings": {
                    "operationMode": "Server",
                    "autoExpandSelect": true,
                    "earlyRequests": true
                }
            },
            "i18n": {
                "type": "sap.ui.model.resource.ResourceModel",
                "settings": { "bundleName": "cds.plugin.caching.dashboardfe.i18n.i18n" }
            },
            "@i18n": {
                "type": "sap.ui.model.resource.ResourceModel",
                "uri": "i18n/i18n.properties"
            }
        },
        "contentDensities": { "compact": true, "cozy": true },
        "routing": {
            "config": {},
            "routes": [
                {
                    "pattern": ":?query:",
                    "name": "CachesList",
                    "target": "CachesList"
                },
                {
                    "pattern": "Caches({key}):?query:",
                    "name": "CachesObjectPage",
                    "target": "CachesObjectPage"
                },
                {
                    "pattern": "Caches({key})/metrics({metricsKey}):?query:",
                    "name": "MetricsObjectPage",
                    "target": "MetricsObjectPage"
                }
            ],
            "targets": {
                "CachesList": {
                    "type": "Component",
                    "id": "CachesList",
                    "name": "sap.fe.templates.ListReport",
                    "options": {
                        "settings": {
                            "contextPath": "/Caches",
                            "variantManagement": "Page",
                            "initialLoad": "Enabled",
                            "navigation": {
                                "Caches": {
                                    "detail": {
                                        "route": "CachesObjectPage"
                                    }
                                }
                            },
                            "controlConfiguration": {
                                "@com.sap.vocabularies.UI.v1.LineItem": {
                                    "tableSettings": {
                                        "type": "ResponsiveTable"
                                    }
                                }
                            }
                        }
                    }
                },
                "CachesObjectPage": {
                    "type": "Component",
                    "id": "CachesObjectPage",
                    "name": "sap.fe.templates.ObjectPage",
                    "options": {
                        "settings": {
                            "contextPath": "/Caches",
                            "navigation": {
                                "metrics": {
                                    "detail": {
                                        "route": "MetricsObjectPage"
                                    }
                                }
                            },
                            "content": {
                                "body": {
                                    "sections": {
                                        "OverviewSection": {
                                            "title": "{i18n>tabOverview}",
                                            "template": "cds.plugin.caching.dashboardfe.ext.Overview",
                                            "position": { "placement": "Before", "anchor": "GeneralInformationSection" }
                                        },
                                        "MetricsSection": {
                                            "title": "{i18n>tabMetrics}",
                                            "template": "cds.plugin.caching.dashboardfe.ext.MetricsSection",
                                            "position": { "placement": "After", "anchor": "OverviewSection" }
                                        },
                                        "KeyMetricsSection": {
                                            "title": "{i18n>tabKeyMetrics}",
                                            "template": "cds.plugin.caching.dashboardfe.ext.KeyMetricsSection",
                                            "position": { "placement": "After", "anchor": "MetricsSection" }
                                        },
                                        "EntriesSection": {
                                            "title": "{i18n>tabEntries}",
                                            "template": "cds.plugin.caching.dashboardfe.ext.EntriesSection",
                                            "position": { "placement": "After", "anchor": "KeyMetricsSection" }
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "MetricsObjectPage": {
                    "type": "Component",
                    "id": "MetricsObjectPage",
                    "name": "sap.fe.templates.ObjectPage",
                    "options": {
                        "settings": {
                            "entitySet": "Metrics",
                            "contextPath": "/Caches/metrics",
                            "content": {
                                "body": {
                                    "sections": {
                                        "ReadThroughChartsSection": {
                                            "title": "Read-Through Performance",
                                            "template": "cds.plugin.caching.dashboardfe.ext.MetricsReadThroughCharts"
                                        },
                                        "NativeChartsSection": {
                                            "title": "Native Function Performance",
                                            "template": "cds.plugin.caching.dashboardfe.ext.MetricsNativeCharts",
                                            "position": { "placement": "After", "anchor": "ReadThroughChartsSection" }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "extends": {
            "extensions": {
                "sap.ui.controllerExtensions": {
                    "sap.fe.templates.ObjectPage.ObjectPageController": {
                        "controllerName": "cds.plugin.caching.dashboardfe.ext.ObjectPageExtension"
                    }
                }
            }
        }
    }
}
